<!doctype html>
<html lang="ja">
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{{ title }}</title>
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/github-markdown-css/5.8.1/github-markdown.min.css" >
    <style>
    body {
        margin: 2em;
    }
	textarea {
		font-size: large;
		font-family: sans-serif;

	}
	.markdown-body code {
		display: block;
	}
    </style>

	<script>
	function toggle_edit() {
		var ele1 = document.getElementById('article');
		var ele2 = document.getElementById('edit');
		if (ele2.style.display == 'none'){
		  ele1.style.display = 'none';
		  ele2.style.display = 'block';
		}else{
		  ele2.style.display = 'none';
		  ele1.style.display = 'block';
		}
	}

	function save_content() {
	   content = document.getElementById('content').value;
	   console.log(content);
	   const headers = new Headers();
	   headers.append('Content-Type', 'application/json');

	   const request = new Request("/rest/save", {
	     method: 'POST',
		 headers: headers,
		 body: JSON.stringify({
		   'name': '{{ title }}',
		   'dirname': '{{ dirname}}',
		   'content': content
		   })
	   });
		   
          fetch(request)
	    .then(response => {
		  console.log(response.json());
                  location.reload();
		 })
	    .catch(error => {
		  console.log(error);
		});
	}
	</script>
</head>
<body>
<button onclick="toggle_edit()">Edit</button> [<a href="/"> TOPへ </a>]
<hr>
<article id="article" class="markdown-body" style="display:blcok;">
    {{ html }}
</article>
<div id="edit" style="display:none">
<button onclick="save_content()">Save</button><br>
<textarea cols="80" rows="25" id='content'>{{ content }}</textarea>
</div>

</body>
</html>
